{
  "about": "Machine numbering cases for tooling.machines.number_layout and builder/core.mjs numberLayout. Each case numbers `machines` ([id, kind, requested]) in order against `layout` and the fixed numbers (tooling.machines.FIXED_NUMBERS, with each machine's kind); `numbers` is the layout after, less the fixed machines, or `error` a fragment of the refusal.",
  "fixed": [
    ["fm2op", "synth", {"engine": 34, "page": 82}],
    ["macroosc", "synth", {"engine": 26, "page": 83}],
    ["ringmod", "effect", {"effect": 1, "page": 21}],
    ["timestretch", "sample", {"engine": 35, "page": 7}]
  ],
  "cases": [
    {"name": "a machine gets the free numbers it asks for",
     "machines": [["pluck", "synth", {"engine": 40, "page": 90}]],
     "numbers": {"pluck": {"engine": 40, "page": 90}}},
    {"name": "fixed numbers go to their own machine alone",
     "machines": [["copy", "synth", {"engine": 34, "page": 82}]],
     "numbers": {"copy": {"engine": 36, "page": 84}}},
    {"name": "engines in stock's own table are never given out",
     "machines": [["pluck", "synth", {"engine": 1, "page": 84}]],
     "numbers": {"pluck": {"engine": 36, "page": 84}}},
    {"name": "a dropped machine keeps its numbers",
     "layout": {"gone": {"engine": 36, "page": 84}},
     "machines": [["next", "synth", {"engine": 36, "page": 84}]],
     "numbers": {"gone": {"engine": 36, "page": 84}, "next": {"engine": 37, "page": 85}}},
    {"name": "a machine keeps its numbers in the layout over the ones it asks for",
     "layout": {"pluck": {"engine": 50, "page": 100}},
     "machines": [["pluck", "synth", {"engine": 36, "page": 84}]],
     "numbers": {"pluck": {"engine": 50, "page": 100}}},
    {"name": "the first machine in order gets a number two ask for",
     "machines": [["first", "synth", {"engine": 40, "page": 90}], ["second", "synth", {"engine": 40, "page": 90}]],
     "numbers": {"first": {"engine": 40, "page": 90}, "second": {"engine": 36, "page": 84}}},
    {"name": "sample engines keep their stock page, which they share",
     "machines": [["sampler", "sample", {"engine": 35, "page": 2}], ["drums", "sample", {"engine": 41, "page": 7}]],
     "numbers": {"sampler": {"engine": 36, "page": 2}, "drums": {"engine": 41, "page": 7}}},
    {"name": "effects take effect numbers and share the FX page",
     "machines": [["echo", "effect", {"effect": 1, "page": 21}], ["fold", "effect", {"effect": 11, "page": 21}]],
     "numbers": {"echo": {"effect": 2, "page": 21}, "fold": {"effect": 11, "page": 21}}},
    {"name": "a layout cannot renumber a machine with fixed numbers",
     "layout": {"fm2op": {"engine": 40, "page": 90}},
     "machines": [],
     "error": "fm2op has fixed numbers"},
    {"name": "a layout cannot hold a fixed number",
     "layout": {"old": {"engine": 34, "page": 90}},
     "machines": [],
     "error": "both hold engine 34"},
    {"name": "a firmware runs out of effect numbers",
     "machines": [["e2", "effect", {"effect": 2, "page": 21}], ["e3", "effect", {"effect": 2, "page": 21}],
                  ["e4", "effect", {"effect": 2, "page": 21}], ["e6", "effect", {"effect": 2, "page": 21}],
                  ["e7", "effect", {"effect": 2, "page": 21}], ["e8", "effect", {"effect": 2, "page": 21}],
                  ["e11", "effect", {"effect": 2, "page": 21}], ["e12", "effect", {"effect": 2, "page": 21}]],
     "error": "No free effect number for e12"},
    {"name": "a sample engine that changes its stock page cannot keep its layout entry",
     "layout": {"sampler": {"engine": 36, "page": 2}},
     "machines": [["sampler", "sample", {"engine": 36, "page": 7}]],
     "error": "now asks for stock page 7"}
  ]
}
